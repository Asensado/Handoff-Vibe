"""Retire the unsigned privileged updater; no network or installer operations."""
import os
from pathlib import Path
import sys

MARKER = Path('/etc/handoff/automatic-updates')
HOOK = Path('/etc/apt/apt.conf.d/99handoff-vibe-updates')
DISABLED = ('Automatic and in-app installation are disabled until independently '
            'authenticated release signing is available. Review releases and install manually.')


def main():
    if os.geteuid() != 0:
        raise SystemExit('Administrator authentication is required.')
    if len(sys.argv) != 2 or sys.argv[1] not in ('enable', 'disable', 'run', 'run-automatic'):
        raise SystemExit('Choose disable. Unsigned privileged installation is unavailable.')
    if sys.argv[1] == 'disable':
        MARKER.unlink(missing_ok=True)
        HOOK.unlink(missing_ok=True)
        print('Automatic updates disabled.')
        return
    # Fail closed even if a stale marker/hook survives or the service is started directly.
    raise SystemExit(DISABLED)


if __name__ == '__main__':
    main()
