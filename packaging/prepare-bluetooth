#!/usr/bin/python3 -I
"""Fixed-operation privileged helper. No paths or commands accepted from callers."""
import datetime
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


def prepared_config(text):
    # Preserve an already-correct effective assignment, wherever it sits.
    section = None
    active = []
    for line in text.splitlines():
        stripped = line.strip()
        if re.fullmatch(r'\[[^]]+\]', stripped):
            section = stripped.lower()
        elif section == '[general]':
            match = re.match(r'^\s*DeviceID\s*=\s*(.*?)\s*$', line, re.I)
            if match:
                active.append(match[1].lower())
    if active == ['bluetooth:004c:0000:0000']:
        return text
    lines = text.splitlines(keepends=True)
    output = []
    section = None
    added = False
    for line in lines:
        stripped = line.strip()
        if re.fullmatch(r'\[[^]]+\]', stripped):
            section = stripped.lower()
            output.append(line if line.endswith('\n') else line + '\n')
            if section == '[general]' and not added:
                output.append('DeviceID = bluetooth:004C:0000:0000\n')
                added = True
            continue
        if section == '[general]' and re.match(r'^\s*DeviceID\s*=', line, re.I):
            continue
        output.append(line)
    if not added:
        output = ['[General]\n', 'DeviceID = bluetooth:004C:0000:0000\n', '\n'] + output
    return ''.join(output)


def write_atomic(path, text, stat):
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix='.handoff-')
    try:
        os.fchmod(fd, stat.st_mode & 0o777)
        os.fchown(fd, stat.st_uid, stat.st_gid)
        with os.fdopen(fd, 'w') as file:
            file.write(text)
            file.flush()
            os.fsync(file.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    if len(sys.argv) != 1 or os.geteuid() != 0:
        raise RuntimeError('This helper needs administrator authorization and accepts no arguments.')
    path = Path('/etc/bluetooth/main.conf')
    if path.is_symlink() or not path.is_file():
        raise RuntimeError('Bluetooth configuration is missing or uses a custom symlink. Nothing was changed.')
    original = path.read_text()
    changed = prepared_config(original)
    if changed == original:
        print('Bluetooth is already prepared.')
        return
    stat = path.stat()
    directory = Path('/var/backups/handoff')
    directory.mkdir(mode=0o700, exist_ok=True)
    if directory.is_symlink():
        raise RuntimeError('The backup directory is a symlink. Nothing was changed.')
    backup = directory / ('main.conf.' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f'))
    shutil.copy2(path, backup)
    write_atomic(path, changed, stat)
    try:
        subprocess.run(['/usr/bin/systemctl', 'restart', 'bluetooth.service'], check=True, capture_output=True, text=True, timeout=30)
    except Exception:
        write_atomic(path, original, stat)
        subprocess.run(['/usr/bin/systemctl', 'restart', 'bluetooth.service'], capture_output=True, timeout=30)
        raise RuntimeError('Bluetooth could not restart. Its original configuration was restored.')
    print('Bluetooth prepared. Previously paired headsets may need re-pairing.')

if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
