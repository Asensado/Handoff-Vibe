<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Asensado</vendor>
  <action id="io.github.asensato.Handoff.prepare-bluetooth">
    <description>Prepare Bluetooth for Handoff audio switching</description>
    <message>Handoff needs to update the Bluetooth Device ID and restart Bluetooth. Connected Bluetooth devices will temporarily disconnect.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/handoff/prepare-bluetooth</annotate>
  </action>
</policyconfig>
